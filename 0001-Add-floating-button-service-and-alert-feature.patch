+                Expanded(
+                  child: _selectedTab == 'Groups'
+                      ? (_groups.isEmpty
+                          ? Padding(
+                              padding: const EdgeInsets.only(top: 100),
+                              child: Image.asset(
+                                'assets/images/noGroups.png',
