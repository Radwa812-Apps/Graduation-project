+                          child: Image.asset(
+                            'assets/images/noChats.png',
+                            width: screenWidth * .8.w,
+                            height: screenHeight * .8.h,
+                          ),
+                        ),
+                ),
+              ],
+            ),
+          ),
+          if (_selectedTab == 'Groups') ...[
+            if (_isDraggableSheetVisible)
+              GestureDetector(
+                onTap: _toggleDraggableSheet,
+                child: ContainerTextFieldWidget(
